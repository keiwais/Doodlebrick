# Copy this file to ".env" (the real .env is git-ignored) and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (defaults shown)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Test the whole AI flow without a key or internet (returns canned results)
# MOCK_AI=1

# When the front-end is hosted elsewhere (e.g. GitHub Pages), allow only that origin:
# ALLOWED_ORIGIN=https://your-name.github.io

# Abuse protection for your key
# RATE_PER_MINUTE=12
# MAX_DAILY_CALLS=300
# PORT=8787

# --- Local image generation + AI coach together (what the demo uses) ---
# AI_PROVIDER=comfyui          -> "Generate with AI" runs on your own computer (ComfyUI)
# COMFYUI_BASE=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=v1-5-pruned-emaonly-fp16.safetensors
# GEMINI_API_KEY above         -> turns on the AI coach (drawing tips) even when AI_PROVIDER=comfyui